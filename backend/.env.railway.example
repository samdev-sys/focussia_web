# Fijar como variables de entorno de los servicios de Railway (ProductionRailway).
# Railway provee DATABASE_URL automáticamente al agregar el plugin de Postgres.

# ── Servidor / Django ────────────────────────────────────────────────────────
SECRET_KEY=genera-una-clave-larga-y-aleatoria   # no reusar la de desarrollo
DEBUG=False
ALLOWED_HOSTS=backend-xxxx.up.railway.app,tu-dominio.com
# Ej.: https://focussia.netlify.app (sin "/" final, una por línea separadas por coma)
CORS_ALLOWED_ORIGINS=https://focussia.netlify.app
# Cache compartida: REQUERIDA. Con varios workers de gunicorn, LocMemCache
# rompería el estado conversacional del agente FocusIA.
REDIS_URL=${{Redis.REDIS_URL}}
# Redis del plugin de Railway (pégalo: se inyecta como ${{Redis.REDIS_URL}}).

# ── IA (avisos/interpretación de reportes, agente, ayuda del onboarding) ────
GROQ_API_KEY=gsk_...
GROQ_AGENT_MODEL=openai/gpt-oss-120b

# ── Web Push (notificaciones del navegador) ─────────────────────────────────
VAPID_PUBLIC_KEY=BBqi...
VAPID_PRIVATE_KEY_B64=MIGH...
VAPID_CLAIM_SUB=mailto:soporte@focusia.app

# ── Email (password reset; vacío = imprime en consola) ──────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Focusia <no-reply@focusia.app>

# ── WhatsApp (opcional: log | twilio | meta) ────────────────────────────────
WHATSAPP_PROVIDER=log
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=

# ── OAuth (si se van a usar los botones Google/Microsoft) ───────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
