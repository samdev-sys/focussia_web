# FRONTEND Configuration
VITE_API_URL=http://localhost:8000


# OAuth - Google (Client ID from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_client_id
# Backend valida aud del id_token; usa el mismo Client ID (o lista separada por comas)
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id

# OAuth - Microsoft (Application ID from Azure Portal)
VITE_MICROSOFT_CLIENT_ID=your_microsoft_client_id


# Backend (Django)
# Generar SECRET_KEY: python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=focusia_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432

# Node environment
NODE_ENV=development

# Groq (AI Assistant)
GROQ_API_KEY=your_groq_api_key_here


# Modelo del asistente de voz. Ej: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_AGENT_MODEL=llama-3.3-70b-versatile

# Correo (recuperación de contraseña).
# Si EMAIL_HOST está vacío, Django usa el backend de consola: los correos se
# imprimen en los logs y NO se envían. En producciónconfigura un SMTP alcanzable.
# Ejemplo con Resend: EMAIL_HOST=smtp.resend.com, EMAIL_PORT=587,
# EMAIL_HOST_USER=resend, EMAIL_HOST_PASSWORD=<API key de Resend>.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Focusia <no-reply@focusia.app>
FRONTEND_RESET_URL=http://localhost:3000/reset-password
