# FRONTEND Configuration
VITE_API_URL=http://localhost:8000

# OAuth - Google (Client ID from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# OAuth - Microsoft (Application ID from Azure Portal)
VITE_MICROSOFT_CLIENT_ID=your_microsoft_client_id


# Backend (Django)
# Generar SECRET_KEY: python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=focusia_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432

# Node environment
NODE_ENV=development

# Groq (AI Assistant)
GROQ_API_KEY=your_groq_api_key_here


# Modelo del asistente de voz. Ej: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_AGENT_MODEL=llama-3.3-70b-versatile
